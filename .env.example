# ---------------------------------------------------------------------------
# Heritage Housekeepers | Operations Hub — environment variables
# Copy to .env.local for local development; add the same keys in Vercel.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable / anon key — safe in the browser (all access is enforced by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — SERVER ONLY. Used to create employee logins and by cron jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used in invite / password-reset emails and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret that Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=generate-a-long-random-string

# Email notifications (optional). Uses Resend (https://resend.com). Leave blank to keep email off.
RESEND_API_KEY=
EMAIL_FROM="Heritage Housekeepers <ops@yourdomain.com>"

# Future channels — the delivery outbox already supports these; add a provider in src/lib/notify/channels.ts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# GoHighLevel integration (Settings → Integrations shows the full setup)
# Secret in the webhook URL that GHL workflows call. Generate a long random string.
GHL_WEBHOOK_SECRET=
# GHL → Settings → Private Integrations → create token with scope "contacts.write" (for tagging completed jobs)
GHL_PRIVATE_TOKEN=
# Tag added to the GHL contact when a cleaning is completed
GHL_COMPLETED_TAG=cleaning-completed
